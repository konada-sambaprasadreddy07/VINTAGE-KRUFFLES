# ==========================================
# VINTAGE KRUFFLES — ENVIRONMENT CONFIGURATION
# ==========================================

# Server configuration
PORT=5000
NODE_ENV=development

# MySQL Database Connection (via Prisma)
# Replace with your actual MySQL credentials (user, password, host, port, database)
DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/vintage_kruffles"

# JWT Authentication Secret (for Admin session security)
JWT_SECRET="vintage_kruffles_jwt_secret_key_change_in_prod_2026"

# Frontend Origin for CORS
FRONTEND_URL="http://localhost:5173"

# Official Cafe WhatsApp Number for Click-to-Chat Orders (Include Country Code e.g. 91...)
# Editable also via Admin Settings Dashboard
WHATSAPP_PHONE_NUMBER="918978941336"

# Meta WhatsApp Cloud API credentials (Optional — if omitted, runs in Demo & Click-to-Chat Mode)
WHATSAPP_BUSINESS_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Default Administrator Seed Credentials
ADMIN_INITIAL_EMAIL="admin@vintagekruffles.com"
ADMIN_INITIAL_PASSWORD="Admin@Kruffles2026"
