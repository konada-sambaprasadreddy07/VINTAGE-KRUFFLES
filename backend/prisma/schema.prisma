datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id              Int       @id @default(autoincrement())
  name            String?
  phone           String    @unique
  email           String?
  birthday        DateTime?
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  marketingConsents MarketingConsent[]
  loyaltyAccount    LoyaltyAccount?
  orders            Order[]
  campaignRecipients CampaignRecipient[]
  feedbacks         CustomerFeedback[]
}

model MarketingConsent {
  id          Int      @id @default(autoincrement())
  phone       String
  consentType String   @default("WHATSAPP_PROMO")
  isConsented Boolean  @default(true)
  source      String   @default("WEBSITE_POPUP")
  ipAddress   String?
  optedOutAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customerId  Int?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([phone])
}

model MenuCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  icon        String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items       MenuItem[]
}

model MenuItem {
  id            Int          @id @default(autoincrement())
  name          String
  slug          String       @unique
  description   String       @db.Text
  price         Decimal      @db.Decimal(10, 2)
  image         String       @db.Text
  categoryId    Int
  category      MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isAvailable   Boolean      @default(true)
  isBestseller  Boolean      @default(false)
  isTodaySpecial Boolean     @default(false)
  isVeg         Boolean      @default(true)
  prepTimeMins  Int          @default(15)
  calories      String?
  allergens     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orderItems    OrderItem[]
  todaySpecials TodaySpecial[]

  @@index([categoryId])
}

model TodaySpecial {
  id            Int       @id @default(autoincrement())
  menuItemId    Int?
  menuItem      MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  title         String
  description   String    @db.Text
  image         String    @db.Text
  originalPrice Decimal?  @db.Decimal(10, 2)
  offerPrice    Decimal   @db.Decimal(10, 2)
  badgeText     String?   @default("Chef's Special")
  startDate     DateTime  @default(now())
  endDate       DateTime
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isActive, endDate])
}

model GalleryImage {
  id        Int      @id @default(autoincrement())
  title     String
  caption   String?  @db.Text
  imageUrl  String   @db.Text
  category  String   @default("Waffles")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              Int             @id @default(autoincrement())
  orderNumber     String          @unique
  customerId      Int?
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName    String
  customerPhone   String
  pickupTime      DateTime
  orderNotes      String?         @db.Text
  status          String          @default("PENDING")
  subtotal        Decimal         @db.Decimal(10, 2)
  discount        Decimal         @default(0.00) @db.Decimal(10, 2)
  tax             Decimal         @default(0.00) @db.Decimal(10, 2)
  total           Decimal         @db.Decimal(10, 2)
  paymentMethod   String          @default("PAY_AT_PICKUP")
  paymentStatus   String          @default("PENDING")
  isWhatsAppOrder Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items           OrderItem[]
  statusHistory   OrderStatusHistory[]

  @@index([status])
  @@index([customerPhone])
  @@index([pickupTime])
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId Int?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  itemName   String
  itemPrice  Decimal  @db.Decimal(10, 2)
  quantity   Int      @default(1)
  lineTotal  Decimal  @db.Decimal(10, 2)
  options    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orderId])
}

model OrderStatusHistory {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  comment   String?  @db.Text
  updatedBy String?  @default("SYSTEM")
  createdAt DateTime @default(now())

  @@index([orderId])
}

model LoyaltyAccount {
  id                 Int      @id @default(autoincrement())
  customerId         Int      @unique
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phone              String   @unique
  visitCount         Int      @default(0)
  currentCycleVisits Int      @default(0)
  rewardsEarned      Int      @default(0)
  rewardsAvailable   Int      @default(0)
  birthdayMonth      Int?
  birthdayDay        Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  transactions       LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id               Int            @id @default(autoincrement())
  loyaltyAccountId Int
  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  orderId          Int?
  transactionType  String
  visitsDelta      Int            @default(0)
  rewardsDelta     Int            @default(0)
  description      String         @db.Text
  createdAt        DateTime       @default(now())

  @@index([loyaltyAccountId])
}

model Reward {
  id                Int      @id @default(autoincrement())
  title             String
  description       String   @db.Text
  requiredVisits    Int      @default(10)
  rewardType        String   @default("FREE_ITEM")
  discountAmount    Decimal? @db.Decimal(10, 2)
  eligibleItemName  String?
  isActive          Boolean  @default(true)
  termsConditions   String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CustomerFeedback {
  id                Int       @id @default(autoincrement())
  customerId        Int?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName      String?
  customerPhone     String?
  overallRating     Int
  foodQualityRating Int
  serviceRating     Int
  orderReference    String?
  comments          String    @db.Text
  allowFollowUp     Boolean   @default(false)
  isApproved        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([isApproved])
}

model Review {
  id           Int      @id @default(autoincrement())
  customerName String
  rating       Decimal  @db.Decimal(2, 1) @default(5.0)
  comment      String   @db.Text
  platform     String   @default("Google")
  reviewDate   DateTime @default(now())
  isFeatured   Boolean  @default(true)
  isActive     Boolean  @default(true)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FestivalCampaign {
  id              Int       @id @default(autoincrement())
  name            String
  occasion        String
  messageTemplate String    @db.Text
  offerDetails    String?   @db.Text
  scheduledFor    DateTime?
  status          String    @default("DRAFT")
  sentCount       Int       @default(0)
  totalTarget     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  recipients      CampaignRecipient[]
}

model CampaignRecipient {
  id          Int              @id @default(autoincrement())
  campaignId  Int
  campaign    FestivalCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId  Int?
  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  phone       String
  customerName String?
  status      String           @default("PENDING")
  sentAt      DateTime?
  errorMessage String?         @db.Text
  createdAt   DateTime         @default(now())

  @@index([campaignId])
}

model BusinessSetting {
  id             Int      @id @default(autoincrement())
  key            String   @unique
  value          String   @db.Text
  category       String   @default("GENERAL")
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
